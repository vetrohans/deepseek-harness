{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0-rc.5",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "dsh-runtime",
      "node-dist"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.mac.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "dsh-desktop": {
      "runtime": {
        "mode": "bundled",
        "dataDir": "home",
        "npmRegistry": "https://registry.npmmirror.com",
        "manifestUrl": "https://github.com/<owner>/deepseek-harness-desktop/releases/latest/download/runtime-manifest-${TARGET}.json",
        "mirrorUrl": "https://npmmirror.com/mirrors/dsh-desktop",
        "presetPlugins": []
      }
    }
  }
}
